rules_version = '2';

// Firestore security rules for the site.
// Publish these in the Firebase console (Firestore → Rules), or with
// `firebase deploy --only firestore:rules`. See README → "Firestore security rules".
service cloud.firestore {
  match /databases/{database}/documents {

    // An admin is a signed-in user with a document at admins/{their uid}.
    // Being signed in is not enough: Firebase lets anyone create an account
    // with the site's public API key unless sign-ups are turned off.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isText(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    function hasText(v, maxLen) {
      return isText(v, maxLen) && v.size() > 0;
    }

    // ── Admin list ── created by hand in the Firebase console only.
    // A user may read their own entry (the PHP endpoints use this to verify admins).
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Public site settings ──
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Calendar credentials and other admin-only data ──
    match /private/{doc} {
      allow read, write: if isAdmin();
    }

    // ── Testimonials submitted from the public form ──
    // Visitors may only create a well-formed, unapproved entry of sane size.
    match /testimonials/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'role', 'quote', 'stars', 'approved', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'quote', 'stars', 'approved', 'createdAt'])
        && hasText(request.resource.data.name, 100)
        && (!('role' in request.resource.data) || isText(request.resource.data.role, 100))
        && hasText(request.resource.data.quote, 2000)
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ── Booking requests from the public form ──
    match /bookings/{doc} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'service', 'date', 'time', 'notes', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'email', 'service', 'date', 'status', 'createdAt'])
        && hasText(request.resource.data.name, 100)
        && isText(request.resource.data.email, 200)
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
        && (!('phone' in request.resource.data) || isText(request.resource.data.phone, 40))
        && hasText(request.resource.data['service'], 100)   // "service" is a reserved word, so no dot syntax
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('time' in request.resource.data) || isText(request.resource.data.time, 20))
        && (!('notes' in request.resource.data) || isText(request.resource.data.notes, 2000))
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // Anything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
